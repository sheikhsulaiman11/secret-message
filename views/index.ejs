<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secret Messages</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white min-h-screen">

    <!-- Navbar -->
    <nav class="bg-gray-900 border-b border-gray-800 px-6 py-4">
        <h1 class="text-xl font-bold text-purple-400 tracking-widest text-center">🤫 Secret Messages</h1>
    </nav>

    <div class="max-w-2xl mx-auto px-4 py-10">

        <!-- Message Form -->
        <div class="bg-gray-900 rounded-2xl p-6 mb-10 border border-gray-800 shadow-lg">
            <h2 class="text-lg font-semibold text-gray-300 mb-4">Send an Anonymous Message</h2>
            <form action="/messages" method="POST">
                <textarea
                    name="text"
                    rows="3"
                    maxlength="300"
                    placeholder="Say something anonymously..."
                    class="w-full bg-gray-800 text-white placeholder-gray-500 rounded-xl p-4 resize-none outline-none border border-gray-700 focus:border-purple-500 transition"
                ></textarea>
                <div class="flex justify-between items-center mt-3">
                    <span class="text-gray-500 text-sm">Max 300 characters</span>
                    <button
                        type="submit"
                        class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-6 py-2 rounded-xl transition"
                    >
                        Send
                    </button>
                </div>
            </form>
        </div>

        <!-- Feed -->
        <h2 class="text-lg font-semibold text-gray-400 mb-4">Public Feed</h2>

        <% if(messages.length === 0) { %>
            <div class="text-center text-gray-600 mt-20">
                <p class="text-4xl mb-3">🤫</p>
                <p>No messages yet. Be the first!</p>
            </div>
        <% } %>

        <div class="flex flex-col gap-4">
            <% messages.forEach(msg => { %>
                <div class="bg-gray-900 border border-gray-800 rounded-2xl p-5 shadow-md hover:border-purple-700 transition">
                    <p class="text-white text-base leading-relaxed"><%= msg.text %></p>
                    <span class="text-gray-500 text-xs mt-3 block"><%= msg.time %></span>
                </div>
            <% }) %>
        </div>

    </div>

</body>
</html>