<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secret Messages</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-950 text-white h-screen flex flex-col">

    <!-- Navbar -->
    <nav class="bg-gray-900 border-b border-gray-800 px-6 py-4 flex items-center gap-3 shrink-0">
        <div class="w-9 h-9 rounded-full bg-purple-600 flex items-center justify-center text-sm font-bold">S</div>
        <div>
            <h1 class="font-semibold text-white text-sm">Secret Messages</h1>
            <p class="text-xs text-green-400">Anonymous & Public</p>
        </div>
    </nav>

   

    <!-- Chat Feed — scrollable -->
    <div id="messages" class="flex-1 overflow-y-auto px-4 py-4 flex flex-col gap-3">

        <% if(messages.length === 0) { %>
            <div id="empty" class="text-center text-gray-600 mt-20">
                <p class="text-4xl mb-3">🤫</p>
                <p class="text-sm">No messages yet. Be the first!</p>
            </div>
        <% } %>

        <% messages.forEach(msg => { %>
            <div class="flex flex-col max-w-xs lg:max-w-md">
                <div class="bg-gray-800 rounded-2xl rounded-tl-sm px-4 py-2 shadow">
                    <p class="text-sm text-white leading-relaxed"><%= msg.text %></p>
                    <span class="text-xs text-gray-500 mt-1 block text-right"><%= msg.time %></span>
                </div>
            </div>
        <% }) %>

    </div>

    <!-- Input Bar — fixed at bottom like whatsapp -->
    <div class="bg-gray-900 border-t border-gray-800 px-4 py-3 shrink-0">
        <form action="/" method="POST" class="flex items-center gap-3">
            <input
                type="text"
                name="text"
                maxlength="300"
                placeholder="Type an anonymous message..."
                class="flex-1 bg-gray-800 text-white placeholder-gray-500 rounded-full px-5 py-2 text-sm outline-none border border-gray-700 focus:border-purple-500 transition"
            />
            <button
                type="submit"
                class="bg-purple-600 hover:bg-purple-700 text-white rounded-full w-10 h-10 flex items-center justify-center transition shrink-0"
            >
                ➤
            </button>
        </form>
    </div>

    <script src="/socket.io/socket.io.js"></script>

<script>
    const socket = io();

    socket.on('newMessage', (message) => {
        // remove "no messages" placeholder if it exists
        const empty = document.querySelector('#empty');
        if (empty) empty.remove();

        const wrapper = document.createElement('div');
        wrapper.className = 'flex flex-col max-w-xs lg:max-w-md';
        wrapper.innerHTML = `
            <div class="bg-gray-800 rounded-2xl rounded-tl-sm px-4 py-2 shadow">
                <p class="text-sm text-white leading-relaxed">${message.text}</p>
                <span class="text-xs text-gray-500 mt-1 block text-right">${message.time}</span>
            </div>
        `;

        document.querySelector('#messages').appendChild(wrapper);

        // auto scroll to bottom
        const feed = document.querySelector('#messages');
        feed.scrollTop = feed.scrollHeight;
    });
</script>

</body>
</html>